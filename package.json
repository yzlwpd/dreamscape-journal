{
  "name": "dreamscape-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs",
    "demo": "node server/demo.mjs",
    "db:init": "node server/init-db.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src server tests index.html vite.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src server tests index.html vite.config.js package.json .prettierrc.json"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-vue-next": "^0.468.0",
    "mysql2": "^3.14.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "playwright": "^1.51.0",
    "prettier": "3.6.2",
    "sharp": "^0.34.0",
    "vite": "^6.3.0"
  }
}
